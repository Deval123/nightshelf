# Copy to .env and edit. .env is git-ignored; do not commit real values.

# Host directory of the clip library (mounted read-only into the container).
CLIPBANK_HOST_DIR=/path/to/ClipBank

# Base URL of the Ollama API. Plain http, no authentication: it must only be
# reachable from the machine that runs the indexer.
# With the bundled "ollama" profile use http://ollama:11434
# From Docker Desktop on macOS a host Ollama is http://host.docker.internal:11434 (localhost would be the container itself).
OLLAMA_URL=http://ollama.example:11434

# Optional
VISION_MODEL=gemma3:4b
EMBED_MODEL=nomic-embed-text
FRAME_COUNT=3
